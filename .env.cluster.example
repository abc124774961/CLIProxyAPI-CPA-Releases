# Cluster JWT example.
# After deploying https://github.com/router-for-me/CLIProxyAPIHome, get the JWT value with:
# curl -sS -X POST "http://<home-host>:8327/v0/management/certificates/clients" -H "X-MANAGEMENT-KEY: <management-key>" | jq -r '.home_jwt'
# Then paste it into HOME_JWT here or export it before starting Compose.
HOME_JWT=your-home-jwt-here

# The cluster node still validates the storefront lease locally. Set the same
# license values used by the standalone Compose deployment. Keep secrets out
# of Git and provide them through the customer's deployment environment.
# MANAGEMENT_PASSWORD=change-me-to-a-strong-password
# Optional Antigravity OAuth application credentials (needed only for the
# Antigravity OAuth provider; keep the values in the deployment environment).
# ANTIGRAVITY_OAUTH_CLIENT_ID=your-google-oauth-client-id
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
CPA_LICENSE_PUBLIC_KEY=kJhDRBpfneFdURvPXwiGW3XAmPrd2HVVORfHzP-eYTg
CPA_LICENSE_PLUGIN_PUBLIC_KEY=OHRHVVIlFC34K-5AQUkOPcZLeiSpeX_n_VPbrH3agXQ
CPA_LICENSE_PROVIDER=shop666
CPA_LICENSE_PRODUCT_CODE=CPA
CPA_LICENSE_API_BASE_URL=https://p.666ttt.net/api/storefront
# CPA_LICENSE_CLIENT_ID=issued-client-id
# CPA_LICENSE_CLIENT_SECRET=issued-client-secret
# Compose always mounts /run/secrets/cpa-license-client-secret. Secret-file
# mode sets the host source and writes the secret to that file; a non-empty file
# takes precedence over the direct value.
# CPA_LICENSE_CLIENT_SECRET_HOST_PATH=./secrets/cpa-license-client-secret
CPA_LICENSE_STATE_DIR=/CLIProxyAPI/data/license
CPA_LICENSE_REFRESH_INTERVAL=10m
CPA_LICENSE_GRACE_PERIOD=6h
# CPA_LICENSE_STORAGE_KEY=replace-only-if-your-deployment-requires-a-stable-key
# CLI_PROXY_LICENSE_PATH=./data/license
# CLI_PROXY_PULL_POLICY=build
# VERSION=customer-release
# COMMIT=git-commit-sha
# BUILD_DATE=2026-09-03T00:00:00Z
