# Example environment configuration for CLIProxyAPI.
# Copy this file to `.env` and uncomment the variables you need.
#
# NOTE: Environment variables are also used for the storefront license bridge.
# Keep the public/secret values in the deployment environment rather than in
# config.yaml or a committed file.

# ------------------------------------------------------------------------------
# Management Web UI
# ------------------------------------------------------------------------------
# MANAGEMENT_PASSWORD=change-me-to-a-strong-password

# ------------------------------------------------------------------------------
# Antigravity Google OAuth (optional; required only when using Antigravity OAuth)
# ------------------------------------------------------------------------------
# These are deployment-time application credentials. They are intentionally not
# embedded in the public release. The values are read when OAuth login or token
# refresh runs, so loading them from this .env file works after startup.
# ANTIGRAVITY_OAUTH_CLIENT_ID=your-google-oauth-client-id
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ----------------------------------------------------------------------------
# Customer deployment paths and image
# ----------------------------------------------------------------------------
# Public bundle tag: v7.2.148-cpa.7-beta.1. The pinned CPA component image remains
# v7.2.148-cpa.7-beta.1; this beta uses prebuilt public artifacts only.
# CLI_PROXY_IMAGE=ghcr.io/abc124774961/cli-proxy-api-cpa:v7.2.148-cpa.7-beta.1
# CLI_PROXY_PULL_POLICY=always
# Host-side port for the CPA HTTP listener; the container port remains 8317.
# Set this to 18320 (or another free port) when validating beside an existing node.
CLI_PROXY_HOST_PORT=8317
# Container name; choose a unique value when cli-proxy-api already exists.
CLI_PROXY_CONTAINER_NAME=cli-proxy-api
# Optional host-side OAuth/legacy callback ports (container ports stay fixed).
# Change these when another local service owns one of the defaults.
CLI_PROXY_HOST_PORT_8085=8085
CLI_PROXY_HOST_PORT_1455=1455
CLI_PROXY_HOST_PORT_54545=54545
CLI_PROXY_HOST_PORT_51121=51121
CLI_PROXY_HOST_PORT_11451=11451
# VERSION=customer-release
# COMMIT=git-commit-sha
# BUILD_DATE=2026-09-03T00:00:00Z
# CLI_PROXY_CONFIG_PATH=./config.yaml
# CLI_PROXY_AUTH_PATH=./auths
# CLI_PROXY_LOG_PATH=./logs
# CLI_PROXY_PLUGIN_PATH=./plugins
# CLI_PROXY_LICENSE_PATH=./data/license

# ----------------------------------------------------------------------------
# CPA storefront authorization (required for API requests)
# ----------------------------------------------------------------------------
# These publisher keys are public release metadata, not customer secrets. Keep
# them pinned to the values recorded in release-manifest.json so a fresh public
# checkout can validate signed leases and advanced-plugin manifests directly.
CPA_LICENSE_PUBLIC_KEY=kJhDRBpfneFdURvPXwiGW3XAmPrd2HVVORfHzP-eYTg
CPA_LICENSE_PLUGIN_PUBLIC_KEY=OHRHVVIlFC34K-5AQUkOPcZLeiSpeX_n_VPbrH3agXQ
CPA_LICENSE_PROVIDER=shop666
CPA_LICENSE_PRODUCT_CODE=CPA
CPA_LICENSE_API_BASE_URL=https://p.666ttt.net/api/storefront
# CPA_LICENSE_CLIENT_ID=issued-client-id
# Compose always mounts /run/secrets/cpa-license-client-secret. Direct-secret
# mode (recommended for a simple install) sets the value below; the installer
# creates an empty host file and an empty file does not override this value.
# CPA_LICENSE_CLIENT_SECRET=issued-client-secret
# Secret-file mode sets the host source and writes the secret to that file.
# A non-empty file takes precedence over the direct value.
# CPA_LICENSE_CLIENT_SECRET_HOST_PATH=./secrets/cpa-license-client-secret
CPA_LICENSE_STATE_DIR=/CLIProxyAPI/data/license
CPA_LICENSE_SHOP_AUTH_URL=https://p.666ttt.net/shop/?authorize=cpa
CPA_LICENSE_SHOP_EXCHANGE_PATH=/licenses/exchange
CPA_LICENSE_ACTIVATE_PATH=/licenses/activate
CPA_LICENSE_REFRESH_PATH=/licenses/refresh
CPA_LICENSE_VERIFY_PATH=/licenses/verify
CPA_LICENSE_GRACE_PATH=/licenses/grace
CPA_LICENSE_REFRESH_INTERVAL=10m
CPA_LICENSE_GRACE_PERIOD=6h
# CPA_LICENSE_STORAGE_KEY=replace-only-if-your-deployment-requires-a-stable-key
# CPA_LICENSE_EXECUTABLE_SHA256=optional-release-sha256
# CPA_LICENSE_CLAIM_PATH=optional-legacy-claim-path

# Optional provider preflight (read by scripts/check-license-deployment.sh only;
# these values are not passed to the CPA container). The URL must be a
# non-mutating storefront dry-run/preflight route. Do not point it at the live
# /licenses/grace route unless the provider documents a dry-run query or path.
# CPA_LICENSE_PREFLIGHT_URL=https://STORE_HOST/api/storefront/licenses/preflight
# CPA_LICENSE_PREFLIGHT_BODY={"product":"CPA","instance_id":"preflight-TARGET","dry_run":true}
# CPA_LICENSE_PREFLIGHT_BODY_FILE=./secrets/cpa-license-preflight.json

# ------------------------------------------------------------------------------
# Postgres Token Store (optional)
# ------------------------------------------------------------------------------
# PGSTORE_DSN=postgresql://user:pass@localhost:5432/cliproxy
# PGSTORE_SCHEMA=public
# PGSTORE_LOCAL_PATH=/var/lib/cliproxy

# ------------------------------------------------------------------------------
# Git-Backed Config Store (optional)
# ------------------------------------------------------------------------------
# GITSTORE_GIT_URL=https://github.com/your-org/cli-proxy-config.git
# GITSTORE_GIT_USERNAME=git-user
# GITSTORE_GIT_TOKEN=ghp_your_personal_access_token
# GITSTORE_LOCAL_PATH=/data/cliproxy/gitstore

# ------------------------------------------------------------------------------
# Object Store Token Store (optional)
# ------------------------------------------------------------------------------
# OBJECTSTORE_ENDPOINT=https://s3.your-cloud.example.com
# OBJECTSTORE_BUCKET=cli-proxy-config
# OBJECTSTORE_ACCESS_KEY=your_access_key
# OBJECTSTORE_SECRET_KEY=your_secret_key
# OBJECTSTORE_LOCAL_PATH=/data/cliproxy/objectstore
